+    // concerned (thousands) and with it their match with a PGO profile: for a build whose profile is collected with it.
+    int fewerModeSwitches = 0;
+
+    // [Switch] Round 15, XENON_RECOMP_EXPLICIT_FMA=1 (tools/build-switch.sh SWITCH_EXPLICIT_FMA, which also compiles
+    // everything with -ffp-contract=off): the guest's fused multiply-adds (fmadd[s], fmsub[s], fnmadd[s], fnmsub[s],
+    // vmaddfp, vnmsubfp, vmaddcfp128) as explicit fused operations (__builtin_fma, PPCVectorFma), giving the results
+    // GCC's contraction of those single expressions gave; with contraction off, nothing else is fused, so every other
+    // guest operation rounds on its own as on the Xbox 360, and no code generation change can move a rounding.
+    bool explicitFma = false;
+
+    // [Switch] Round 15, XENON_RECOMP_SCALAR_RSQRT=1: vrsqrtefp and vrefp whose source was last written, in the same
